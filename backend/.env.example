# ── Backend environment (copy to backend/.env and fill in) ──
# Never commit the real .env. Keep secrets out of git.

# Database — Supabase Postgres connection string (with pgvector enabled)
# e.g. postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# Auth — REQUIRED: set to a strong random secret (min 32 chars). App will not start without this.
JWT_SECRET=

# LLM — Ollama (local, primary)
# Run: ollama serve  |  ollama pull llama3
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECS=600

# LLM — DeepSeek (cloud fallback / training data generation only)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OCR (Surya remote via Colab/ngrok); leave blank to use local fallback
COLAB_OCR_URL=

# PDF rendering (Poppler bin path), e.g. C:\poppler\bin
POPPLER_PATH=

# Email (SMTP) — used for verification / notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# URLs
APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Supabase Storage (added in Iter 0/1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# CORS — comma-separated list of allowed frontend origins (Iter 21)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting — requests per window (Iter 21)
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_ASK_QUERY=30
RATE_LIMIT_PROCESS_DOC=10
RATE_LIMIT_DEFAULT=120

# Session TTL in seconds — abandoned processing sessions are evicted after this (Iter 23)
SESSION_TTL_SECS=7200
