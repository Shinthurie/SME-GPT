# Secrets — must never be baked into the image (set these as host env/secrets)
.env
.env.*
*.env

# Python caches / build artefacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Tests (not needed at runtime; the app never imports them)
tests/
test_*.py
*_test.py

# Runtime-generated / local-only dirs (recreated on the host at startup)
saved_documents/
uploads/
outputs/
debug/
logs/
*.log

# Notebooks and editor/OS noise
*.ipynb
.vscode/
.idea/
.DS_Store
